# =============================================================================
# Edger — Next.js 16 + Clerk + Supabase
# Copy to `.env.local` and fill in real values. Never commit real secrets.
# =============================================================================

# ── Clerk ───────────────────────────────────────────────────────────────────
# Public (browser) — Clerk Dashboard → API keys
# https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only — never expose to the client
CLERK_SECRET_KEY=

# Optional Clerk redirect URLs (Next.js App Router)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# ── Supabase ────────────────────────────────────────────────────────────────
# Public — Dashboard → Project Settings → Data API → publishable / default key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy alias (keeps old `*_ANON_KEY` consumers happy)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — service role bypasses RLS; keep on the server only.
# Used by `src/lib/supabase/admin.ts` for webhooks / cron / privileged jobs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk ↔ Supabase ────────────────────────────────────────────────────────
# Name of the Clerk JWT template that Supabase accepts as third-party auth.
# Default when unset is `supabase`. Configure in Clerk Dashboard → JWT templates,
# then enable Clerk as third-party auth in Supabase Dashboard → Authentication.
# Set to `none` or `false` to skip Authorization on every request (anon-only).
# NEXT_PUBLIC_CLERK_SUPABASE_JWT_TEMPLATE=supabase
